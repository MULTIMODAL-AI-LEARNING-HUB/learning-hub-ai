# AI Service Configuration

# Gemini (Primary Model - Multimodal)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq (Fast Model - Intent Classification)
GROQ_API_KEY=your_groq_api_key

# Redis (Cache & Comms)
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant (Vector Database)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# API Configuration
PORT=8001
DEBUG=false
LOG_LEVEL=INFO

# Internal API Key (for worker communication)
INTERNAL_API_KEY=CHANGEME_generate_with_python_secrets_token_hex_16
AI_CHAT_RATE_LIMIT_PER_MINUTE=20
